{
  "device": "cuda",
  "torch_dtype": "float32",
  "dataset": "wikitext-2",
  "split": "validation",
  "hardware_preset": "ir_drop_quant_8bit",
  "rpu_overrides": {
    "forward.ir_drop": 2.0,
    "forward.inp_res": 62,
    "forward.out_res": 62
  },
  "rotation_mode": "hadamard_D",
  "r2_mode": "hadamard_D",
  "seed": 0,
  "r2_seed_offset": 1,
  "max_eval_tokens": 8192,
  "online_hadamards": false,
  "run_float_prepared": true 
}
